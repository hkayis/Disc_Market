<%- include('partials/header', { title: 'Edit Product' }) %>

<section>
  <h2>Edit Product</h2>

  <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
    <div style="background: #ffe0e0; padding: 1rem; border: 1px solid red; margin-bottom: 1rem;">
      <ul>
        <% errors.forEach(err => { %>
          <li><%= err.msg %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form 
    action="/market/products/<%= product.id %>/edit" 
    method="POST" 
    enctype="multipart/form-data"
  >
    <div>
      <label for="title">Product Title:</label>
      <input 
        type="text" 
        name="title" 
        id="title"
        value="<%= product.title %>"
      >
    </div>

    <div>
      <label for="stock">Stock:</label>
      <input 
        type="number" 
        name="stock" 
        id="stock"
        min="1"
        value="<%= product.stock %>"
      >
    </div>

    <div>
      <label for="normal_price">Normal Price:</label>
      <input 
        type="number" 
        step="0.01" 
        name="normal_price" 
        id="normal_price"
        min="0"
        value="<%= product.normal_price %>"
      >
    </div>

    <div>
      <label for="discounted_price">Discounted Price:</label>
      <input 
        type="number" 
        step="0.01" 
        name="discounted_price" 
        id="discounted_price"
        min="0"
        value="<%= product.discounted_price %>"
      >
    </div>

    <div>
      <label for="expiration_date">Expiration Date:</label>
      <input 
        type="date" 
        name="expiration_date" 
        id="expiration_date"
        value="<%= product.expiration_date instanceof Date 
          ? product.expiration_date.toISOString().slice(0, 10) 
          : product.expiration_date %>"
      >
    </div>

    <div>
      <p>Current Image:</p>

      <% if (product.image_path) { %>
        <img 
          src="/uploads/<%= product.image_path %>" 
          alt="<%= product.title %>" 
          style="width: 150px; height: auto;"
        >
      <% } else { %>
        <p>No image</p>
      <% } %>
    </div>

    <div>
      <label for="image">Change Image:</label>
      <input 
        type="file" 
        name="image" 
        id="image"
        
      >
      <p style="font-size: 0.9rem;">Leave empty if you do not want to change the image.</p>
    </div>

    <button type="submit">Update Product</button>
  </form>

  <p><a href="/market/products">Back to Products</a></p>
</section>

<%- include('partials/footer') %>
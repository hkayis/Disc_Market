<%- include('partials/header', { title: 'Market Dashboard' }) %>

<section>
  <h2>Market Dashboard</h2>

  <p>
    Welcome, <strong><%= market.name %></strong>
  </p>

  <div style="background: #f5f5f5; padding: 1rem; border: 1px solid #ddd; margin-bottom: 1rem;">
    <h3>Market Information</h3>

    <p><strong>Email:</strong> <%= market.email %></p>
    <p><strong>Market Name:</strong> <%= market.name %></p>
    <p><strong>City:</strong> <%= market.city %></p>
    <p><strong>District:</strong> <%= market.district %></p>
  </div>

  <div style="background: #f5f5f5; padding: 1rem; border: 1px solid #ddd; margin-bottom: 1rem;">
    <h3>Product Summary</h3>

    <p><strong>Total Products:</strong> <%= totalProducts %></p>
    <p><strong>Expired Products:</strong> <%= expiredProducts %></p>
  </div>

  <div style="background: #f5f5f5; padding: 1rem; border: 1px solid #ddd; margin-bottom: 1rem;">
    <h3>Actions</h3>

    <ul>
      <li><a href="/market/products">View My Products</a></li>
      <li><a href="/market/products/add">Add New Product</a></li>
      <li><a href="/market/profile">Edit Market Information</a></li>
    </ul>
  </div>

  <form action="/logout" method="POST">
    <button type="submit">Logout</button>
  </form>
</section>

<%- include('partials/footer') %>